---
import '../styles/global.css';
const {title='Ecosesi — Ciência para entender o mundo',description='Ciência, meio ambiente e novas ideias. Um olhar curioso sobre o mundo em que vivemos.'} = Astro.props;
const categories=['Meio ambiente','Ciência','Tecnologia','Saúde','Universo'];
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#173e32"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href="/favicon.svg"/><title>{title}</title></head><body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<div class="topline"><span>CIÊNCIA. CONTEXTO. DESCOBERTA.</span><a href="/sobre/">Conheça a revista <span aria-hidden="true">↗</span></a></div>
<header class="masthead"><a class="wordmark" href="/" aria-label="Ecosesi, início">ecosesi<span>.</span></a><p>Um olhar curioso.<br/>Um mundo de descobertas.</p><a class="search-link" aria-label="Buscar matérias" href="/materias/#busca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>Buscar</span></a></header>
<nav class="nav" aria-label="Navegação principal"><a href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}>Início</a>{categories.map(c=><a href={'/materias/?editoria='+encodeURIComponent(c)}>{c}</a>)}<a class="all-nav" href="/materias/">Todas as matérias <span aria-hidden="true">↗</span></a></nav>
<main id="conteudo"><slot/></main>
<footer><div class="footer-top"><a class="wordmark" href="/">ecosesi<span>.</span></a><p>Ciência mais perto.<br/>Conhecimento mais longe.</p><a href="/sobre/">Sobre a Ecosesi ↗</a><a href="/materias/">Explore as matérias ↗</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Ecosesi · Revista de divulgação científica</span><span>Feita para quem tem perguntas.</span></div></footer>
</body></html>
